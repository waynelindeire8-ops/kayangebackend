# Copy to .env for local dev. On your host (Render/Railway/Fly), set these in the dashboard instead.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=

# Who may call this API from a browser (your Cloudflare Pages / custom domain). Comma-separated.
FRONTEND_ORIGINS=https://app.yourdomain.com

# HTTPS in production = 1. Local http://localhost = 0.
COOKIE_SECURE=1
# Lax works when UI and API are subdomains of the same domain. Use None only for unrelated domains.
COOKIE_SAMESITE=Lax
# Optional: share the login cookie across subdomains, e.g. .yourdomain.com
COOKIE_DOMAIN=

# Supabase (fill in with the NEW credentials after you rotate the old ones)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_DB_URL=

# Optional OneDrive backups
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_TENANT_ID=common
ONEDRIVE_REFRESH_TOKEN=
ONEDRIVE_USER_EMAIL=
